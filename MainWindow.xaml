<Window x:Class="MarketStockManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MarketStock Manager - Supermarket Inventory" Height="780" Width="1180"
        MinHeight="680" MinWidth="1050" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="4,4,4,10"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MarketStock Manager" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Desktop aplikacija za supermarket, zalihe, prodaju i izveštaje" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Osveži podatke" Click="RefreshAll_Click" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="12" Background="Transparent">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Pregled poslovanja" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Broj proizvoda" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="ProductCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Vrednost zaliha" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="StockValueText" Text="0 RSD" FontSize="32" FontWeight="Bold" Foreground="#16A34A"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Niske zalihe" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="LowStockCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Današnja prodaja" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="TodaySalesText" Text="0 RSD" FontSize="32" FontWeight="Bold" Foreground="#7C3AED"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Današnjih računa" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="TodayReceiptsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EA580C"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Ukupna prodaja" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="TotalSalesText" Text="0 RSD" FontSize="32" FontWeight="Bold" Foreground="#0891B2"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Proizvodi sa niskim zalihama" Style="{StaticResource SectionTitle}"/>
                                <DataGrid x:Name="DashboardLowStockGrid" Height="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                                        <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Kategorija" Binding="{Binding CategoryName}" Width="160"/>
                                        <DataGridTextColumn Header="Stanje" Binding="{Binding StockQuantity, StringFormat={}{0:N2}}" Width="100"/>
                                        <DataGridTextColumn Header="Minimum" Binding="{Binding MinStock, StringFormat={}{0:N2}}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Proizvodi">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProductSearchTextBox" Grid.Column="0" TextChanged="ProductSearch_TextChanged" ToolTip="Pretraga po nazivu, SKU ili barkodu"/>
                            <ComboBox x:Name="CategoryFilterComboBox" Grid.Column="1" SelectionChanged="CategoryFilter_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            <CheckBox x:Name="LowStockOnlyCheckBox" Grid.Column="2" Content="Samo niske zalihe" VerticalAlignment="Center" Checked="LowStockOnly_Changed" Unchecked="LowStockOnly_Changed"/>
                            <Button Grid.Column="3" Content="Novi proizvod" Click="NewProduct_Click" Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="370"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <DataGrid x:Name="ProductsGrid" SelectionChanged="ProductsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                                    <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Kategorija" Binding="{Binding CategoryName}" Width="140"/>
                                    <DataGridTextColumn Header="Stanje" Binding="{Binding StockQuantity, StringFormat={}{0:N2}}" Width="90"/>
                                    <DataGridTextColumn Header="Min" Binding="{Binding MinStock, StringFormat={}{0:N2}}" Width="70"/>
                                    <DataGridTextColumn Header="Cena" Binding="{Binding SalePrice, StringFormat={}{0:N2}}" Width="90"/>
                                    <DataGridCheckBoxColumn Header="Nisko" Binding="{Binding IsLowStock, Mode=OneWay}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Forma proizvoda" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="SKU" Style="{StaticResource MutedText}"/>
                                    <TextBox x:Name="SkuTextBox"/>
                                    <TextBlock Text="Barkod" Style="{StaticResource MutedText}"/>
                                    <TextBox x:Name="BarcodeTextBox"/>
                                    <TextBlock Text="Naziv proizvoda" Style="{StaticResource MutedText}"/>
                                    <TextBox x:Name="NameTextBox"/>
                                    <TextBlock Text="Kategorija" Style="{StaticResource MutedText}"/>
                                    <ComboBox x:Name="ProductCategoryComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                    <TextBlock Text="Jedinica mere" Style="{StaticResource MutedText}"/>
                                    <ComboBox x:Name="UnitComboBox">
                                        <ComboBoxItem Content="kom"/>
                                        <ComboBoxItem Content="kg"/>
                                        <ComboBoxItem Content="l"/>
                                        <ComboBoxItem Content="pak"/>
                                    </ComboBox>
                                    <TextBlock Text="Nabavna cena" Style="{StaticResource MutedText}"/>
                                    <TextBox x:Name="PurchasePriceTextBox"/>
                                    <TextBlock Text="Prodajna cena" Style="{StaticResource MutedText}"/>
                                    <TextBox x:Name="SalePriceTextBox"/>
                                    <TextBlock Text="Stanje lagera" Style="{StaticResource MutedText}"/>
                                    <TextBox x:Name="StockQuantityTextBox"/>
                                    <TextBlock Text="Minimalna zaliha" Style="{StaticResource MutedText}"/>
                                    <TextBox x:Name="MinStockTextBox"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Sačuvaj" Click="SaveProduct_Click" Style="{StaticResource SuccessButton}"/>
                                        <Button Content="Obriši" Click="DeleteProduct_Click" Style="{StaticResource DangerButton}"/>
                                        <Button Content="Očisti" Click="ClearProductForm_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Zalihe">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="StockProductComboBox" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            <ComboBox x:Name="StockTypeComboBox" Grid.Column="1">
                                <ComboBoxItem Content="Ulaz robe"/>
                                <ComboBoxItem Content="Otpis"/>
                                <ComboBoxItem Content="Korekcija +"/>
                                <ComboBoxItem Content="Korekcija -"/>
                            </ComboBox>
                            <TextBox x:Name="MovementQuantityTextBox" Grid.Column="2" ToolTip="Količina"/>
                            <TextBox x:Name="MovementUnitCostTextBox" Grid.Column="3" ToolTip="Nabavna cena"/>
                            <TextBox x:Name="MovementNoteTextBox" Grid.Column="4" ToolTip="Napomena"/>
                            <Button Grid.Column="5" Content="Upiši promenu" Click="AddMovement_Click" Style="{StaticResource SuccessButton}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Istorija promena zaliha" Style="{StaticResource SectionTitle}"/>
                            <DataGrid x:Name="MovementsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                                    <DataGridTextColumn Header="Proizvod" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="130"/>
                                    <DataGridTextColumn Header="Količina" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="100"/>
                                    <DataGridTextColumn Header="Cena" Binding="{Binding UnitCost, StringFormat={}{0:N2}}" Width="100"/>
                                    <DataGridTextColumn Header="Napomena" Binding="{Binding Note}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Prodaja">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SaleProductComboBox" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            <TextBox x:Name="SaleQuantityTextBox" Grid.Column="1" Text="1"/>
                            <Button Grid.Column="2" Content="Dodaj u račun" Click="AddToCart_Click" Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <DataGrid x:Name="CartGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Proizvod" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Količina" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="Cena" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="Ukupno" Binding="{Binding LineTotal, Mode=OneWay, StringFormat={}{0:N2}}" Width="140"/>
                                <DataGridTextColumn Header="Na stanju" Binding="{Binding AvailableStock, StringFormat={}{0:N2}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CartTotalText" Text="Ukupno: 0 RSD" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Ukloni stavku" Click="RemoveCartItem_Click"/>
                            <Button Grid.Column="2" Content="Završi prodaju" Click="FinishSale_Click" Style="{StaticResource SuccessButton}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Izveštaji">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Najprodavaniji proizvodi" Style="{StaticResource SectionTitle}"/>
                            <DataGrid x:Name="TopProductsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Proizvod" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Količina" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="120"/>
                                    <DataGridTextColumn Header="Iznos" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Poslednji računi" Style="{StaticResource SectionTitle}"/>
                            <DataGrid x:Name="SalesGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                                    <DataGridTextColumn Header="Broj računa" Binding="{Binding ReceiptNumber}" Width="*"/>
                                    <DataGridTextColumn Header="Iznos" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
